      "title": "Dust Sender"
     },
     "lookalike_of": {
      "items": {
       "$ref": "#/components/schemas/LookalikeMatch"
      },
      "title": "Lookalike Of",
      "type": "array"
     },
     "reasons": {
      "items": {
       "type": "string"
      },
      "title": "Reasons",
      "type": "array"
     },
     "risk_level": {
      "enum": [
       "low",
       "medium",
       "high",
       "critical"
      ],
      "title": "Risk Level",
      "type": "string"
     },
     "verdict": {
      "enum": [
       "lookalike",
       "suspicious",
       "no_match"
      ],
      "title": "Verdict",
      "type": "string"
     }
    },
    "required": [
     "chain",
     "address",
     "verdict",
     "risk_level",
     "lookalike_of",
     "dust_sender",
     "reasons",
     "checked_at"
    ],
    "title": "LookalikeReport",
    "type": "object"
   },
   "LookalikeRequest": {
    "properties": {
     "address": {
      "description": "The address you're about to pay",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]{25,64}$",
      "title": "Address",
      "type": "string"
     },
     "chain": {
      "enum": [
       "tron",
       "solana"
