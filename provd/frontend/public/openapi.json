      "minimum": 0.0,
      "title": "Score",
      "type": "integer"
     },
     "signal_coverage": {
      "additionalProperties": {
       "type": "string"
      },
      "title": "Signal Coverage",
      "type": "object"
     }
    },
    "required": [
     "intent_id",
     "score",
     "risk_level",
     "risk_flags",
     "recommended_action",
     "explainability",
     "signal_coverage",
     "decision_record_hash",
     "engine_version",
     "latency_ms",
     "created_at"
    ],
    "title": "ActionScore",
    "type": "object"
   },
