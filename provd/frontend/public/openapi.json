 "info": {
  "title": "Provd API",
  "version": "0.1.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/v1/actions/evaluate": {
   "post": {
    "operationId": "evaluate_action_v1_actions_evaluate_post",
    "parameters": [
     {
      "in": "header",
      "name": "Idempotency-Key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 64,
         "pattern": "^[A-Za-z0-9._:-]{1,64}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Idempotency-Key"
      }
     },
     {
      "in": "header",
      "name": "X-Platform-Context",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 1024,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Platform-Context"
      }
     },
     {
      "in": "header",
      "name": "X-API-Key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Api-Key"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ActionIntent"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ActionScore"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ],
    "summary": "Score a money movement before release",
    "tags": [
     "actions"
    ]
   }
  },
  "/v1/assets/{chain}/{ref}": {
   "get": {
    "operationId": "asset_report_v1_assets__chain___ref__get",
    "parameters": [
     {
      "in": "path",
      "name": "chain",
      "required": true,
      "schema": {
       "title": "Chain",
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "ref",
      "required": true,
      "schema": {
       "title": "Ref",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "title": "Response Asset Report V1 Assets  Chain   Ref  Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     },
