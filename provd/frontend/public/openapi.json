     "intent_type",
     "counterparty"
    ],
    "title": "ActionIntent",
    "type": "object"
   },
   "ActionScore": {
    "properties": {
     "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
     },
     "decision_record_hash": {
      "title": "Decision Record Hash",
      "type": "string"
     },
     "engine_version": {
      "title": "Engine Version",
      "type": "string"
