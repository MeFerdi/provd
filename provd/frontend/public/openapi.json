{
 "components": {
  "schemas": {
   "AccountSignals": {
    "description": "Account-takeover inputs from your device-trust or telco provider (Provd doesn't detect these itself).\n\nSend what you have; every field is optional. Timestamps are when the event happened.",
    "properties": {
     "account_created_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Account Created At"
     },
     "credentials_changed_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Most recent password/PIN/email change",
      "title": "Credentials Changed At"
     },
     "device_changed_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Most recent new device for the counterparty's account",
      "title": "Device Changed At"
     },
     "payout_destination_added_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "When the destination receiving these funds was added to the account",
      "title": "Payout Destination Added At"
     },
     "provider": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Who supplied these signals, e.g. your SIM-swap API vendor",
      "title": "Provider"
     },
     "sim_swap_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Most recent SIM swap / port on the counterparty's number",
      "title": "Sim Swap At"
     }
    },
    "title": "AccountSignals",
    "type": "object"
   },
   "ActionIntent": {
    "properties": {
     "account_signals": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/AccountSignals"
       },
       {
        "type": "null"
       }
      ]
     },
     "amounts": {
      "$ref": "#/components/schemas/Amounts"
     },
     "asset": {
      "anyOf": [
       {
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Reserved; up to 4 KB of JSON",
      "title": "Asset"
     },
     "chain": {
      "title": "Chain",
      "type": "string"
     },
     "context": {
      "description": "Your own reference data, stored with the decision and never scored; up to 4 KB of JSON",
      "title": "Context",
      "type": "object"
     },
     "counterparty": {
      "$ref": "#/components/schemas/Counterparty"
     },
     "float_available": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Your available float for this rail, in amounts.fiat_currency (payout/OTC)",
      "title": "Float Available"
     },
     "intent_id": {
      "anyOf": [
       {
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._:-]{1,64}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Your id (letters, digits, . _ : -); generated if omitted",
      "title": "Intent Id"
     },
     "intent_type": {
      "title": "Intent Type",
      "type": "string"
     },
     "known_counterparties": {
      "description": "Addresses you've paid or traded with before (your address book). Used to catch lookalike (address-poisoning) destinations. Provd also learns them from your released checks.",
      "items": {
       "type": "string"
      },
      "maxItems": 500,
      "title": "Known Counterparties",
      "type": "array"
     },
     "rails": {
      "$ref": "#/components/schemas/Rails"
     },
     "venue": {
      "anyOf": [
       {
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Reserved; up to 4 KB of JSON",
      "title": "Venue"
     }
    },
    "required": [
     "chain",
     "intent_type",
     "counterparty"
    ],
    "title": "ActionIntent",
    "type": "object"
   },
   "ActionScore": {
    "properties": {
     "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
     },
     "decision_record_hash": {
      "title": "Decision Record Hash",
      "type": "string"
     },
     "engine_version": {
      "title": "Engine Version",
      "type": "string"
     },
     "explainability": {
      "items": {
       "$ref": "#/components/schemas/Explanation"
      },
      "title": "Explainability",
      "type": "array"
     },
     "intent_id": {
      "title": "Intent Id",
      "type": "string"
     },
     "latency_ms": {
      "title": "Latency Ms",
      "type": "integer"
     },
     "recommended_action": {
      "enum": [
       "release",
       "hold",
       "reject",
       "manual_review",
       "not_yet_supported"
      ],
      "title": "Recommended Action",
      "type": "string"
     },
     "risk_flags": {
      "items": {
       "$ref": "#/components/schemas/RiskFlag"
      },
      "title": "Risk Flags",
      "type": "array"
     },
     "risk_level": {
      "enum": [
       "low",
       "medium",
       "high",
       "critical"
      ],
      "title": "Risk Level",
      "type": "string"
     },
     "score": {
      "description": "Risk score: 0 = no risk found, 1000 = do not release",
      "maximum": 1000.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "integer"
     },
     "signal_coverage": {
      "additionalProperties": {
       "type": "string"
      },
      "title": "Signal Coverage",
      "type": "object"
     }
    },
    "required": [
     "intent_id",
     "score",
     "risk_level",
     "risk_flags",
     "recommended_action",
     "explainability",
     "signal_coverage",
     "decision_record_hash",
     "engine_version",
     "latency_ms",
     "created_at"
    ],
    "title": "ActionScore",
    "type": "object"
   },
   "Amounts": {
    "properties": {
     "crypto": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Crypto"
     },
     "fiat": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fiat"
     },
     "fiat_currency": {
      "anyOf": [
       {
        "maxLength": 8,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "ISO 4217 code, e.g. KES, NGN, BRL, INR",
      "title": "Fiat Currency"
     }
    },
    "title": "Amounts",
    "type": "object"
   },
   "AttestationRequest": {
    "properties": {
     "amount_base_units": {
      "description": "Amount to release, in the token's smallest unit (USDT/USDC: 6 decimals)",
      "exclusiveMaximum": 1.8446744073709552e+19,
      "exclusiveMinimum": 0.0,
      "title": "Amount Base Units",
      "type": "integer"
     },
     "chain_id": {
      "anyOf": [
       {
        "minimum": 1.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "evm: the chain id the escrow contract runs on (Tron mainnet: 728126428)",
      "title": "Chain Id"
     },
     "program_id": {
      "anyOf": [
       {
        "maxLength": 44,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "solana: the escrow program that will verify it",
      "title": "Program Id"
     },
     "target": {
      "description": "evm: EIP-712 for EVM/Tron (TVM) contracts; solana: for Solana programs",
      "enum": [
       "evm",
       "solana"
      ],
      "title": "Target",
      "type": "string"
     },
     "token_decimals": {
      "default": 6,
      "maximum": 18.0,
      "minimum": 0.0,
      "title": "Token Decimals",
      "type": "integer"
     },
     "ttl_seconds": {
      "default": 600,
      "description": "How long the attestation stays valid",
      "minimum": 30.0,
      "title": "Ttl Seconds",
      "type": "integer"
     },
     "verifying_contract": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "evm: the escrow contract that will verify the attestation (0x...)",
      "title": "Verifying Contract"
     }
    },
    "required": [
     "target",
     "amount_base_units"
    ],
    "title": "AttestationRequest",
    "type": "object"
   },
   "Counterparty": {
    "properties": {
     "phone_hash": {
      "anyOf": [
       {
        "maxLength": 128,
        "minLength": 32,
        "pattern": "^[0-9a-fA-F]+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Phone Hash"
     },
     "wallet_address": {
      "anyOf": [
       {
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9:._-]{1,128}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Wallet Address"
     }
    },
    "title": "Counterparty",
    "type": "object"
   },
   "CounterpartyReport": {
    "properties": {
     "activity": {
      "title": "Activity",
      "type": "object"
     },
     "address": {
      "title": "Address",
      "type": "string"
     },
     "chain": {
      "title": "Chain",
      "type": "string"
     },
     "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
     },
     "engine_version": {
      "title": "Engine Version",
      "type": "string"
     },
     "explainability": {
      "items": {
       "$ref": "#/components/schemas/Explanation"
      },
      "title": "Explainability",
      "type": "array"
     },
     "risk_flags": {
      "items": {
       "$ref": "#/components/schemas/RiskFlag"
      },
      "title": "Risk Flags",
      "type": "array"
     },
     "risk_level": {
      "enum": [
       "low",
       "medium",
       "high",
       "critical"
      ],
      "title": "Risk Level",
      "type": "string"
     },
     "score": {
      "title": "Score",
      "type": "integer"
     },
     "signal_coverage": {
      "additionalProperties": {
       "type": "string"
      },
      "title": "Signal Coverage",
      "type": "object"
     }
    },
    "required": [
     "chain",
     "address",
     "score",
     "risk_level",
     "risk_flags",
     "explainability",
     "activity",
     "signal_coverage",
     "engine_version",
     "checked_at"
    ],
    "title": "CounterpartyReport",
    "type": "object"
   },
   "Explanation": {
    "properties": {
     "contribution": {
      "title": "Contribution",
      "type": "integer"
     },
     "reason": {
      "title": "Reason",
      "type": "string"
     },
     "signal": {
      "title": "Signal",
      "type": "string"
     },
     "source_refs": {
      "items": {
       "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
     },
     "value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     }
    },
    "required": [
     "signal",
     "value",
     "contribution",
     "reason"
    ],
    "title": "Explanation",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
