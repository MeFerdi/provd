     "address"
    ],
    "title": "LookalikeRequest",
    "type": "object"
   },
   "OutcomeReport": {
    "properties": {
     "chain": {
      "default": "tron",
      "title": "Chain",
      "type": "string"
     },
     "intent_id": {
      "anyOf": [
       {
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._:-]{1,64}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Intent Id"
     },
     "occurred_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Occurred At"
     },
     "outcome": {
      "enum": [
       "completed",
       "reversed",
       "refunded",
       "chargeback",
       "fraud_confirmed",
       "fake_confirmation"
      ],
      "title": "Outcome",
      "type": "string"
     },
     "phone_hash": {
      "anyOf": [
       {
        "maxLength": 128,
        "minLength": 32,
        "pattern": "^[0-9a-fA-F]+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Phone Hash"
     },
     "wallet_address": {
      "anyOf": [
       {
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9:._-]{1,128}$",
