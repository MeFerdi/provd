 },
 "openapi": "3.1.0",
 "paths": {
  "/": {
   "get": {
    "operationId": "root__get",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "additionalProperties": {
          "type": "string"
         },
         "title": "Response Root  Get",
         "type": "object"
        }
       }
      },
      "description": "Successful Response"
     }
    },
    "summary": "Root",
    "tags": [
     "meta"
    ]
   }
  },
  "/v1/actions/evaluate": {
   "post": {
    "operationId": "evaluate_action_v1_actions_evaluate_post",
    "parameters": [
     {
      "in": "header",
      "name": "Idempotency-Key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Idempotency-Key"
      }
     },
     {
      "in": "header",
      "name": "X-Platform-Context",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "maxLength": 4096,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Platform-Context"
      }
     },
     {
      "in": "header",
      "name": "X-API-Key",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Api-Key"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ActionIntent"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ActionScore"
        }
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "security": [
     {
      "HTTPBearer": []
     }
    ],
