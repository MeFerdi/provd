     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "LookalikeMatch": {
    "properties": {
     "address": {
      "title": "Address",
      "type": "string"
     },
     "prefix": {
      "description": "Matching leading characters",
      "title": "Prefix",
      "type": "integer"
     },
     "suffix": {
      "description": "Matching trailing characters",
      "title": "Suffix",
      "type": "integer"
     }
    },
    "required": [
     "address",
     "prefix",
     "suffix"
    ],
    "title": "LookalikeMatch",
    "type": "object"
   },
   "LookalikeReport": {
    "properties": {
     "address": {
      "title": "Address",
      "type": "string"
     },
     "chain": {
      "title": "Chain",
      "type": "string"
     },
     "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
     },
     "dust_sender": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
