{
  "name": "provd-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docs": "node scripts/prepare-sites.mjs && NEXT_PUBLIC_MAIN_URL=http://localhost:3000 NEXT_PUBLIC_DOCS_URL=http://localhost:3001 NEXT_PUBLIC_PLAYGROUND_URL=http://localhost:3002 next dev sites/docs -p 3001",
    "dev:playground": "node scripts/prepare-sites.mjs && NEXT_PUBLIC_MAIN_URL=http://localhost:3000 NEXT_PUBLIC_DOCS_URL=http://localhost:3001 NEXT_PUBLIC_PLAYGROUND_URL=http://localhost:3002 next dev sites/playground -p 3002",
    "prebuild": "node scripts/prepare-sites.mjs",
    "build": "next build",
    "build:docs": "node scripts/prepare-sites.mjs && next build sites/docs",
    "build:playground": "node scripts/prepare-sites.mjs && next build sites/playground",
    "build:all": "npm run build && npm run build:docs && npm run build:playground",
    "pages:build": "npm run build",
    "pages:deploy": "wrangler pages deploy out",
    "pages:deploy:docs": "wrangler pages deploy sites/docs/out --project-name provd-docs",
    "pages:deploy:playground": "wrangler pages deploy sites/playground/out --project-name provd-playground",
    "start": "next start",
    "lint": "next lint --dir src && next lint sites/docs --dir app && next lint sites/playground --dir app",
    "type-check": "tsc --noEmit && tsc --noEmit -p sites/docs && tsc --noEmit -p sites/playground",
    "check:verify": "node scripts/check-verify.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-accordion": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-popover": "latest",
    "@radix-ui/react-slider": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.x",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "framer-motion": "^11.x",
    "gray-matter": "^4.0.3",
    "lucide-react": "latest",
    "marked": "^17.0.5",
    "minisearch": "^7.2.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.5",
    "next-mdx-remote": "^6.0.0",
    "react": "18.x",
    "react-dom": "18.x",
    "react-hook-form": "^7.x",
    "react-markdown": "^9.0.1",
    "recharts": "^2.x",
    "remark-gfm": "^4.0.1",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "tailwindcss": "^3.x",
    "zod": "^3.x",
    "zustand": "^4.x"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.12.1",
    "@types/node": "^20.x",
    "@types/react": "^18.x",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.x",
    "eslint-config-next": "^14.x",
    "typescript": "^5.x",
    "wrangler": "^3.114.0"
  }
}
