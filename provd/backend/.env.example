# Copy to .env for local runs. Values here are for local development only — never reuse them in production.
APP_ENV=development
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# Local runs (python main.py / uvicorn). docker compose overrides both with the in-network hosts.
DATABASE_URL=postgresql+asyncpg://provd:provd@localhost:5432/provd
REDIS_URL=redis://localhost:6379/0

# Chain access. Comma-separated, tried in order; use your own provider in production
# (public endpoints rate-limit and don't serve historical state).
ETHEREUM_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org,https://eth.merkle.io
RPC_TIMEOUT_SECONDS=20
MONITOR_INTERVAL_SECONDS=900

# Public endpoint protection
RATE_LIMIT_BACKEND=memory
SCAN_RATE_LIMIT_PER_MINUTE=10
EARLY_ACCESS_RATE_LIMIT_PER_HOUR=5
# Set true only behind a proxy you control that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false

# Change alerts (optional). Webhook receives JSON; Telegram posts to one chat (e.g. your ops channel).
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
PUBLIC_SITE_URL=http://localhost:3000

# Admin credentials (POST /api/v1/auth/token)
BOOTSTRAP_ADMIN_CLIENT_ID=
BOOTSTRAP_ADMIN_CLIENT_SECRET=
BOOTSTRAP_CLIENT_CLIENT_ID=
BOOTSTRAP_CLIENT_CLIENT_SECRET=
