# Copy to .env for local runs. Development values only — never reuse in production.
APP_ENV=development
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# Local runs (python app/main.py). docker compose overrides DATABASE_URL with the in-network host.
DATABASE_URL=postgresql+asyncpg://provd:provd@localhost:5432/provd

# Tron (TronGrid). Works without a key at low volume; get a free key for anything real.
TRONGRID_URL=https://api.trongrid.io
TRONGRID_API_KEY=
HISTORY_CACHE_SECONDS=600
# Token safety (GoPlus) — optional; degrades with a coverage flag when missing or down.
GOPLUS_API_KEY=

# Pay-as-you-go
FREE_MONTHLY_CHECKS=300
# USDT-TRC20 address you control; the indexer matches incoming payments to pending top-ups.
USDT_DEPOSIT_ADDRESS=
MPESA_PAYBILL=
# Card and M-Pesa top-ups via Paystack Checkout (empty = card off, M-Pesa uses the manual paybill above).
# Use sk_test_... until you go live. PAYSTACK_CURRENCY is for cards (KES or USD); M-Pesa is always KES.
# Set the webhook URL in the Paystack dashboard to {API}/v1/webhooks/paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
PUBLIC_SITE_URL=http://localhost:3000

# Public scanner protection
RATE_LIMIT_BACKEND=memory
SCANNER_RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HEADERS=false
INDEXER_INTERVAL_SECONDS=60

# Admin credentials (POST /v1/auth/token): create clients, API keys, confirm top-ups.
BOOTSTRAP_ADMIN_CLIENT_ID=
BOOTSTRAP_ADMIN_CLIENT_SECRET=
BOOTSTRAP_CLIENT_CLIENT_ID=
BOOTSTRAP_CLIENT_CLIENT_SECRET=

# --- HTTP security (production requires explicit values; see SECURITY.md) ---
# CORS_ORIGINS=https://provd.tech,https://www.provd.tech
# ALLOWED_HOSTS=api.provd.tech
# EXPOSE_API_DOCS=false
# MAX_REQUEST_BODY_BYTES=65536
# LOG_FORMAT=json
# Behind Cloudflare: TRUST_PROXY_HEADERS=true and CLIENT_IP_HEADER=CF-Connecting-IP
# TRUST_PROXY_HEADERS=false
# CLIENT_IP_HEADER=
# TRUSTED_PROXY_HOPS=1

# --- Rate limits (per minute unless noted). Production: RATE_LIMIT_BACKEND=redis ---
# RATE_LIMIT_BACKEND=auto
# REDIS_URL=redis://redis:6379/0
# PUBLIC_RATE_LIMIT_PER_MINUTE=120
# SCANNER_RATE_LIMIT_PER_MINUTE=20
# API_KEY_RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=10
# AUTH_LOCKOUT_FAILURES=5
# AUTH_LOCKOUT_MINUTES=15
# INVALID_CREDENTIALS_PER_MINUTE=20
# WEBHOOK_RATE_LIMIT_PER_MINUTE=300
# GLOBAL_RATE_LIMIT_PER_MINUTE=3000
# PAYSTACK_WEBHOOK_IPS=

# --- Database pool / workers ---
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_PGBOUNCER=false
# WEB_CONCURRENCY=2

# --- Solana ---
# Free public RPCs keep about a day of history (enough for lookalike detection). For full history use a Helius
# or Alchemy endpoint and set SOLANA_HISTORY_WINDOW_LIMITED=false.
# SOLANA_RPC_URL=https://solana-rpc.publicnode.com
# SOLANA_INDEX_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_HISTORY_WINDOW_LIMITED=true
# SOLANA_MAX_TRANSACTIONS=30
